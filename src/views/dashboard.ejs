<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>

    <p>Name: <%= name %></p>

    <p>Email: <%= email %></p>

    <% if (locals.user && locals.user.role_name === 'admin') { %>
        <section>
            <h2>Administration</h2>
            <p>
                <a href="/users">Manage Users</a>
            </p>
        </section>
    <% } %>
</main>

<%- include('partials/footer') %>