<%- include('partials/header', {title}) %>

<main>

    <h1><%= title %></h1>

    <h2>Service Project Categories</h2>

    <% if (typeof user !== 'undefined' && user && user.role_name === 'admin') { %>
        <p>
            <a href="/new-category">Create New Category</a>
        </p>
    <% } %>

    <ul>

        <% categories.forEach(category => { %>

            <li>
                <a href="/category/<%= category.category_id %>">
                    <%= category.category_name %>
                </a>
            </li>

        <% }); %>

    </ul>

</main>

<%- include('partials/footer') %>